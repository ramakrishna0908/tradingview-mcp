# X API credentials for tv social publish / auto (copy to .env.social, chmod 600).
# OAuth 1.0a user context from an X developer app with Read and Write permission:
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# or an OAuth 2.0 user token with tweet.write scope:
# X_OAUTH2_ACCESS_TOKEN=
# Kill switch for unattended posting (1 = allow, 0 = block):
SOCIAL_AUTO_PUBLISH=1
