<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ramakrishna.tvdesk</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ramakrishna0908/MyProjects/trading/tradingview-mcp/scripts/desk-report.sh</string>
    </array>

    <!-- Weekdays at 10:10 AM ET. Deliberately after the 09:30-10:00 opening
         range has closed: before that, no setup could honestly be CONFIRMED. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/ramakrishna0908/MyProjects/trading/tradingview-mcp/docs/reports/desk/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ramakrishna0908/MyProjects/trading/tradingview-mcp/docs/reports/desk/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
